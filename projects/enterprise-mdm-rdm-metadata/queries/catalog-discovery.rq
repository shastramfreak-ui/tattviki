PREFIX ex: <https://tattviki.example/enterprise/>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?asset ?title ?classification ?team WHERE {
  ?asset a ex:CatalogAsset ; dct:title ?title ; ex:classification ?classification ; ex:ownedByTeam ?owner .
  ?owner <http://www.w3.org/2000/01/rdf-schema#label> ?team .
}
ORDER BY ?asset
