ex:PartyStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Party status"@en .

ex:status-INACTIVE a skos:Concept,
        ex:ApprovedCode ;
    dct:hasVersion "2026.1" ;
    skos:inScheme ex:PartyStatusScheme ;
    skos:prefLabel "Inactive"@en .

ex:status-SUSPENDED a skos:Concept,
        ex:ApprovedCode ;
    dct:hasVersion "2026.1" ;
    skos:inScheme ex:PartyStatusScheme ;
    skos:prefLabel "Suspended"@en .

ex:status-ACTIVE a skos:Concept,
        ex:ApprovedCode ;
    dct:hasVersion "2026.1" ;
    skos:inScheme ex:PartyStatusScheme ;
    skos:prefLabel "Active"@en .

