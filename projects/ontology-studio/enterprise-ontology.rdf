  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DatasetShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <rdfs:label xml:lang="en">Dataset quality rules</rdfs:label>
    <rdfs:comment xml:lang="en">All datasets should have an owner and a quality score.</rdfs:comment>
    <sh:targetClass rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
    <sh:property rdf:resource="https://example.org/tattviki/enterprise#DatasetShape_property" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DatasetShape_property">
    <sh:path rdf:resource="https://example.org/tattviki/enterprise#ownedBy" />
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:class rdf:resource="https://example.org/tattviki/enterprise#Organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#StudyShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <rdfs:label xml:lang="en">Study quality rules</rdfs:label>
    <rdfs:comment xml:lang="en">All studies must reference a sponsoring organization.</rdfs:comment>
    <sh:targetClass rdf:resource="https://example.org/tattviki/enterprise#ResearchStudy" />
    <sh:property rdf:resource="https://example.org/tattviki/enterprise#StudyShape_property" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#StudyShape_property">
    <sh:path rdf:resource="https://example.org/tattviki/enterprise#sponsoredBy" />
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:class rdf:resource="https://example.org/tattviki/enterprise#Organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#CuratedDatasetShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <rdfs:label xml:lang="en">Curated dataset ownership</rdfs:label>
    <rdfs:comment xml:lang="en">Curated data must have a responsible owner.</rdfs:comment>
    <sh:targetClass rdf:resource="https://example.org/tattviki/enterprise#CuratedDataset" />
    <sh:property rdf:resource="https://example.org/tattviki/enterprise#CuratedDatasetShape_property" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#CuratedDatasetShape_property">
    <sh:path rdf:resource="https://example.org/tattviki/enterprise#ownedBy" />
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:class rdf:resource="https://example.org/tattviki/enterprise#Organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#PartyMasterShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <rdfs:label xml:lang="en">Party master status</rdfs:label>
    <rdfs:comment xml:lang="en">Require a governed lifecycle code.</rdfs:comment>
    <sh:targetClass rdf:resource="https://example.org/tattviki/enterprise#PartyMaster" />
    <sh:property rdf:resource="https://example.org/tattviki/enterprise#PartyMasterShape_property" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#PartyMasterShape_property">
    <sh:path rdf:resource="https://example.org/tattviki/enterprise#recordStatus" />
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DataProductShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <rdfs:label xml:lang="en">Data product contract</rdfs:label>
    <rdfs:comment xml:lang="en">Products must reference their data contract.</rdfs:comment>
    <sh:targetClass rdf:resource="https://example.org/tattviki/enterprise#DataProduct" />
    <sh:property rdf:resource="https://example.org/tattviki/enterprise#DataProductShape_property" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DataProductShape_property">
    <sh:path rdf:resource="https://example.org/tattviki/enterprise#hasContract" />
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:class rdf:resource="https://example.org/tattviki/enterprise#DataContract" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#SourceDatasetShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <rdfs:label xml:lang="en">Source dataset identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Source datasets must declare their origin.</rdfs:comment>
    <sh:targetClass rdf:resource="https://example.org/tattviki/enterprise#SourceDataset" />
    <sh:property rdf:resource="https://example.org/tattviki/enterprise#SourceDatasetShape_property" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#SourceDatasetShape_property">
    <sh:path rdf:resource="https://example.org/tattviki/enterprise#sourceSystem" />
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:nodeID="restriction_OwnedDatasetRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction" />
    <owl:onProperty rdf:resource="https://example.org/tattviki/enterprise#ownedBy" />
    <owl:someValuesFrom rdf:resource="https://example.org/tattviki/enterprise#Organization" />
  </rdf:Description>
  <rdf:Description rdf:nodeID="restriction_ContractualProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction" />
    <owl:onProperty rdf:resource="https://example.org/tattviki/enterprise#hasContract" />
    <owl:someValuesFrom rdf:resource="https://example.org/tattviki/enterprise#DataContract" />
  </rdf:Description>
  <rdf:Description rdf:nodeID="restriction_GovernedCuratedAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction" />
    <owl:onProperty rdf:resource="https://example.org/tattviki/enterprise#ownedBy" />
    <owl:someValuesFrom rdf:resource="https://example.org/tattviki/enterprise#Organization" />
  </rdf:Description>
  <rdf:Description rdf:nodeID="restriction_MasterStatusCardinality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction" />
    <owl:onProperty rdf:resource="https://example.org/tattviki/enterprise#reviewedBy" />
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
  </rdf:Description>
</rdf:RDF>
