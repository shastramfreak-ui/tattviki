<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:sh="http://www.w3.org/ns/shacl#" xmlns:dct="http://purl.org/dc/terms/" xmlns:ex="https://example.org/tattviki/enterprise#">
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <rdfs:label xml:lang="en">Enterprise Data &amp; Research Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Fictional source-to-master data and clinical research integration. Every example record is invented.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#EnterpriseEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Enterprise entity</rdfs:label>
    <rdfs:comment xml:lang="en">Root class for uniquely identified entities managed by the organization.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Organization</rdfs:label>
    <rdfs:comment xml:lang="en">An institution with responsibilities and data stewardship.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
    <owl:disjointWith rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#Person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <rdfs:comment xml:lang="en">A person represented by a governed identity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
    <owl:disjointWith rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#ResearchStudy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Research study</rdfs:label>
    <rdfs:comment xml:lang="en">A synthetic study with a sponsor and datasets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#Dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">A discoverable information asset in the metadata catalog.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
    <rdfs:subClassOf rdf:nodeID="restriction_OwnedDatasetRestriction" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#MasterRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Master record</rdfs:label>
    <rdfs:comment xml:lang="en">Curated identity record representing reconciled source parties.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#ReferenceConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Reference concept</rdfs:label>
    <rdfs:comment xml:lang="en">An approved controlled-vocabulary entry.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#SourceDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Source dataset</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for source dataset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#CuratedDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Curated dataset</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for curated dataset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
    <rdfs:subClassOf rdf:nodeID="restriction_GovernedCuratedAsset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#SemanticDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Semantic dataset</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for semantic dataset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DataProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Data product</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for data product.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
    <rdfs:subClassOf rdf:nodeID="restriction_ContractualProduct" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DataContract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Data contract</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for data contract.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#GovernanceAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Governance asset</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for governance asset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#MetadataCatalog">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Metadata catalog</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for metadata catalog.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#GovernanceAsset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#QualityRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Quality rule</rdfs:label>
