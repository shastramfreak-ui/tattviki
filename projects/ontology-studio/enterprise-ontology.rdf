    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#GovernanceAsset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#SoftwareSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Software system</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for software system.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DataPipeline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Data pipeline</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for data pipeline.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#SoftwareSystem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#BusinessGlossaryTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Business glossary term</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for business glossary term.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#ReferenceConcept" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#PartyMaster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Party master</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for party master.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#MasterRecord" />
    <rdfs:subClassOf rdf:nodeID="restriction_MasterStatusCardinality" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#ProductMaster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
