    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#ResearchStudy" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DataQualityIssue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Data quality issue</rdfs:label>
    <rdfs:comment xml:lang="en">Synthetic enterprise teaching class for data quality issue.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#GovernanceAsset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#ownedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">owned by</rdfs:label>
    <rdfs:comment xml:lang="en">Responsible steward of a dataset.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
    <rdfs:range rdf:resource="https://example.org/tattviki/enterprise#Organization" />
    <owl:inverseOf rdf:resource="https://example.org/tattviki/enterprise#owns" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#owns">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">owns</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of owned by.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#Organization" />
    <rdfs:range rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
    <owl:inverseOf rdf:resource="https://example.org/tattviki/enterprise#ownedBy" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#sponsoredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">sponsored by</rdfs:label>
    <rdfs:comment xml:lang="en">Sponsor of a research study.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#ResearchStudy" />
    <rdfs:range rdf:resource="https://example.org/tattviki/enterprise#Organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#produces">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">produces</rdfs:label>
    <rdfs:comment xml:lang="en">Study generates a dataset.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#ResearchStudy" />
    <rdfs:range rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#derivedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">derived from</rdfs:label>
    <rdfs:comment xml:lang="en">Lineage relation between data assets.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
    <rdfs:range rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#linkedToMaster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">linked to master</rdfs:label>
    <rdfs:comment xml:lang="en">A source identity points to a master identity record.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#Person" />
    <rdfs:range rdf:resource="https://example.org/tattviki/enterprise#MasterRecord" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#managedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label xml:lang="en">managed by</rdfs:label>
    <rdfs:comment xml:lang="en">Fictional enterprise semantic relationship: managed by.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#EnterpriseEntity" />
    <rdfs:range rdf:resource="https://example.org/tattviki/enterprise#Organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#governedBy">
