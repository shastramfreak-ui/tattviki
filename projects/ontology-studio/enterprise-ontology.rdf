  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#qualityScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">quality score</rdfs:label>
    <rdfs:comment xml:lang="en">Numeric quality score from zero to one.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#recordStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">record status</rdfs:label>
    <rdfs:comment xml:lang="en">Local status value; resolve it through the reference-data crosswalk.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#MasterRecord" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#approvalDate">
