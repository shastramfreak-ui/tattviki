  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#sourceSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:label xml:lang="en">source system</rdfs:label>
    <rdfs:comment xml:lang="en">System-of-record code.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/tattviki/enterprise#Dataset" />
