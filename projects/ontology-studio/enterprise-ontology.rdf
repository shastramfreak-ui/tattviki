    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#Person" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#StudyProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
