    <rdfs:subClassOf rdf:resource="https://example.org/tattviki/enterprise#Organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/tattviki/enterprise#DataSteward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label xml:lang="en">Data steward</rdfs:label>
